# ---------------------------------------------------------------------------
# Personal Data Warehouse — environment configuration
# Copy to `.env` and fill in. Only DATABASE_URL is required for the synthetic
# pipeline; the rest are needed only when real connectors are enabled.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by ingestion + dbt) ---
POSTGRES_USER=pdw
POSTGRES_PASSWORD=pdw
POSTGRES_DB=pdw
POSTGRES_PORT=5432

# Connection string used by the Python ingestion app (local uv run).
# Points at localhost because ingestion runs on the host, not in the compose
# network. The dbt container uses the service name `postgres` instead (see
# dbt/profiles.yml).
DATABASE_URL=postgresql://pdw:pdw@localhost:5432/pdw

# dbt target schema (analytics models live here; raw tables live in `public`).
DBT_SCHEMA=analytics

# --- GitHub connector (real sync: `make sync-github`) ---
GITHUB_TOKEN=

# --- Google Calendar connector (real sync: `make sync-calendar`) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- AI layer (future milestone) ---
LLM_API_KEY=